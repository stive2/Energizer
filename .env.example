# API CNPS — copier vers .env et adapter si besoin
VITE_CNPS_API_BASE_URL=http://172.17.15.121:8020
VITE_CNPS_API_TIMEOUT=30000

# En développement local : proxy Vite (/api-cnps) si le navigateur bloque CORS
# VITE_CNPS_API_USE_PROXY=true

# Pas de repli mock — erreurs réseau remontées telles quelles
VITE_CNPS_API_FALLBACK_MOCK=false

# Quand l'API /auth existera : passer à true pour les vrais appels HTTP
# VITE_CNPS_USE_REAL_AUTH=true

# Télé-immatriculation assuré (POST multipart, défaut /assure/tele-immat/gerer-assure)
# VITE_CNPS_API_IMMAT_ASSURE_PATH=/assure/tele-immat/gerer-assure

# ─── teleImmat_0.1 (Tomcat legacy) ───────────────────────────────────────────
# Active les appels JSP + servlet GererAssure (au lieu des mocks purs)
VITE_TELE_IMMAT_USE_LEGACY=true

# En dev Quasar : le navigateur appelle /tele-immat → proxy Vite → Tomcat (évite CORS)
VITE_TELE_IMMAT_USE_PROXY=true

# URL Tomcat où teleImmat_0.1 est déployé :
#   • Serveur distant (RDP / réseau CNPS) :
VITE_TELE_IMMAT_DIRECT_URL=http://172.17.15.121:8080/teleImmat_0.1
#   • Tomcat local sur votre PC :
# VITE_TELE_IMMAT_DIRECT_URL=http://127.0.0.1:8080/teleImmat_0.1

# Timeout HTTP teleImmat (ms) — soumission multipart peut être longue
# VITE_TELE_IMMAT_TIMEOUT=120000
