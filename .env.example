# Variables d'environnement Vite / Quasar
#
# Fichiers versionnés (ne pas éditer pour un cas personnel) :
#   .env.development  → quasar dev
#   .env.production   → quasar build / npm run deploy:laragon
#
# Surcharge locale (gitignored) : copier ce fichier vers .env ou .env.local

# ─── API CNPS (:8020) ───────────────────────────────────────────────────────
VITE_CNPS_API_BASE_URL=http://172.17.15.121:8020
VITE_CNPS_API_TIMEOUT=30000
# true = le navigateur appelle /api-cnps (proxy Vite en dev, Apache en prod)
VITE_CNPS_API_USE_PROXY=true

# ─── teleImmat_0.1 (Tomcat) ─────────────────────────────────────────────────
VITE_TELE_IMMAT_USE_LEGACY=true
VITE_TELE_IMMAT_USE_PROXY=true
VITE_TELE_IMMAT_DIRECT_URL=http://172.17.15.121:8080/teleImmat_0.1
# VITE_TELE_IMMAT_TIMEOUT=120000

# ─── Energizer agent (Tomcat EnergizerDev, session JSP) ─────────────────────
VITE_ENERGIZER_LEGACY_AUTH=true
VITE_ENERGIZER_USE_PROXY=true
VITE_ENERGIZER_BASE_URL=http://172.17.15.121:8080/EnergizerDev
